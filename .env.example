# Run locally without credentials. SQLite stays on the server, never in browser storage.
DATA_BACKEND=local
# For Supabase: change to supabase and fill all three fields below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional absolute path for local SQLite storage; default .data/capsule.sqlite
# LOCAL_DB_PATH=

# Email: Resend verified sender, server-only keys
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Campus Time Capsule <hello@your-verified-domain.com>
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
